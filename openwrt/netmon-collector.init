#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

INTERVAL_SECONDS="${NETMON_INTERVAL_SECONDS:-5}"

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/netmon-collector-loop.sh "$INTERVAL_SECONDS"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
